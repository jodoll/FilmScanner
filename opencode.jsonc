{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Anything outside this project prompts first, whether read or edit.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Structured questions to the human are free.
    { "action": "question", "resource": "*", "effect": "allow" },

    // Edits are free inside the project...
    { "action": "edit", "resource": "*", "effect": "allow" },

    // ...except git's machinery, which must stay human-owned. These repeat the
    // global denies because this file's allow would otherwise win by rule order.
    { "action": "edit", "resource": "*.git", "effect": "deny" },
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },
    { "action": "edit", "resource": "*.gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.config/git/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "/usr/local/etc/gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "/opt/homebrew/etc/gitconfig", "effect": "deny" },

    // The agent may propose policy changes; each one prompts.
    { "action": "edit", "resource": "opencode.json*", "effect": "ask" },

    // Skills, commands, tools and agents prompt too.
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },

    // Plugins run at startup with no execution prompt; keep them out.
    { "action": "edit", "resource": ".opencode/plugin/*", "effect": "deny" },

    // Instructions, the spec, and review visibility.
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "PERMISSIONS.md", "effect": "ask" },
    { "action": "edit", "resource": "docs/*", "effect": "ask" },
    { "action": "edit", "resource": ".gitattributes", "effect": "ask" },
    { "action": "edit", "resource": ".gitignore", "effect": "ask" },
    { "action": "edit", "resource": "scripts/*", "effect": "ask" },
    { "action": "edit", "resource": "platformio.ini", "effect": "ask" }
  ]
}