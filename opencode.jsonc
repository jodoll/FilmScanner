{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Anything outside this project prompts first, whether read or edit.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Edits are free inside the project...
    { "action": "edit", "resource": "*", "effect": "allow" },

    // ...except git's machinery, which must stay human-owned. These repeat the
    // global denies because this file's allow would otherwise win by rule order.
    { "action": "edit", "resource": "*.git", "effect": "deny" },
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },
    { "action": "edit", "resource": "*.gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "$HOME/.config/git/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "/usr/local/etc/gitconfig", "effect": "deny" },
    { "action": "edit", "resource": "/opt/homebrew/etc/gitconfig", "effect": "deny" }
  ]
}
